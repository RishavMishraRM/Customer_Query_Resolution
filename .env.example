# FinTech Agent-Assist Copilot Configuration

# LLM & Embedding Settings (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=dolphin-phi:2.7b
# Alternative model already installed: mistral:latest
OLLAMA_EMBED_MODEL=nomic-embed-text:latest

# Speech-to-Text Settings
# Options: tiny.en, base.en, small.en
WHISPER_MODEL_SIZE=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Database Settings
# Optional local MongoDB URI. If unreachable, system falls back to data/sample_customers.json
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=fintech_copilot

# RAG & Guardrails
RETRIEVAL_CONFIDENCE_THRESHOLD=0.75
MAX_SOP_PASSAGES=3
